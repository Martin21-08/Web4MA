<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Perfil | Mi Cocina</title>
  <link rel="stylesheet" href="/Css/Style.css">
</head>
<body>
  <div class="inicio-app">
    <%- include('Partials/Sidebar') %> 

    <main class="inicio-contenido perfil-contenido">
        <header class="inicio-encabezado">
            <h1>Mi perfil</h1><p>Completa tus datos para personalizar tu experiencia en la cocina.</p>
        </header>

      <form class="perfil-formulario" id="formPerfil">

        <section class="perfil-seccion">
          <h2>Datos personales</h2>
          <div class="perfil-campos">

            <label>Nombre<input id="perfilNombre" type="text" placeholder="Tu nombre"></label>
            <label>Apellido<input id="perfilApellido" type="text" placeholder="Tu apellido"></label>
            <label>Correo electrónico<input id="perfilCorreo" type="email" placeholder="correo@ejemplo.com"></label>
            <label>Teléfono<input id="perfilTelefono" type="tel" placeholder="+56 9 1234 5678"></label>

          </div>
        </section>

        <section class="perfil-seccion">
          <h2>Alergias e intolerancias</h2>
          <p class="perfil-ayuda">Selecciona las opciones que debemos considerar al sugerirte recetas.</p>

          <h3 class="perfil-subseccion">Alergias</h3>
          <div class="perfil-opciones">
            <label><input type="checkbox" name="alergias" value="Huevo"> Huevo</label><label><input type="checkbox" name="alergias" value="Frutos secos"> Frutos secos</label><label><input type="checkbox" name="alergias" value="Maní"> Maní</label><label><input type="checkbox" name="alergias" value="Mariscos"> Mariscos</label><label><input type="checkbox" name="alergias" value="Pescado"> Pescado</label><label><input type="checkbox" name="alergias" value="Soja"> Soja</label>
          </div>

          <h3 class="perfil-subseccion">Intolerancias</h3>
          <div class="perfil-opciones">
            <label><input type="checkbox" name="intolerancias" value="Gluten"> Gluten</label><label><input type="checkbox" name="intolerancias" value="Lactosa"> Lactosa</label><label><input type="checkbox" name="intolerancias" value="Fructosa"> Fructosa</label><label><input type="checkbox" name="intolerancias" value="Sorbitol"> Sorbitol</label>
          </div>
        </section>

        <div class="perfil-acciones">
            <button type="submit" class="boton-generar">Guardar cambios</button>

            <button type="button" class="boton-cerrar-sesion" id="cerrarSesion">Cerrar sesión</button>
        </div>
      </form>
    </main>
  </div>
  <script src="/Js/app.js"></script>
</body>
</html>
