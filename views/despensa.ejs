<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Despensa | Mi Cocina</title>
        <link rel="stylesheet" href="/Css/Style.css">
    </head>
<body>
    <div class="inicio-app">
         <%- include('Partials/Sidebar') %>
<main class="inicio-contenido">
    <header class="inicio-encabezado">
        <h1>Mi despensa</h1>
        <p>Organiza lo que tienes y lo que necesitas comprar.</p>
    </header><section class="historial-bloque">
        
        <h2>Ingredientes disponibles</h2>
        <div class="agregar-linea">
            <input id="nuevoIngrediente" placeholder="Ej: arroz, tomate, pollo" autocomplete="off">
            <div class="acciones-despensa">
                <button class="boton-generar" id="agregarIngredienteDespensa">Agregar ingrediente</button>
                <button class="boton-generar" id="limpiarDespensa" type="button">Limpiar despensa</button>
            </div>
        </div>
        
        <div class="sugerencias" id="sugerenciasDespensa"></div>
        
        <div class="ingredientes-elegidos" id="listaDespensa"></div>
    
    </section><section class="historial-bloque">
        <h2>Lista de compras</h2>
        
        <div class="historial-lista" id="listaCompras"></div>
        
        <div class="perfil-acciones">
            <button class="boton-cerrar-sesion" id="limpiarCompras">Limpiar lista de compras</button>
            <button class="boton-generar" id="completarCompras">Lista completada</button>
        </div>
    </section>
</main>
</div>
<script src="/Js/app.js"></script>
</body>
</html>
