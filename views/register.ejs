<%# Formulario de alta: los nombres de cada campo se envían en el POST a /usuarios/registro. %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/Img/icono.png">
  <link rel="stylesheet" href="/Css/Style.css">
  <title>Crear cuenta</title>
</head>
<body>
  <main class="modal-fondo">
    <%# Express recibe estos campos, el controlador los valida y el modelo los guarda en MySQL. %>
    <form action="/usuarios/registro" method="POST" class="modal-caja" id="formRegistro">
      <div class="icono-cocina">
        <img src="/Img/54479.jpg" alt="Logo de CookIQ">
      </div>
      <h2>Únete a la cocina</h2>
      <% if (error && error.length) { %><p class="mensaje-error" role="alert"><%= error.join(' ') %></p><% } %>
      <% if (success && success.length) { %><p class="mensaje-exito" role="status"><%= success.join(' ') %></p><% } %>
      <p class="subtitulo">Crea tu cuenta y descubre nuevas ideas.</p>
      <input name="nombres" id="registroNombre" type="text" placeholder="Nombre" aria-label="Nombre" required>
      <input name="apellidos" id="registroApellido" type="text" placeholder="Apellido" aria-label="Apellido" required>
      <input name="correo" id="registroCorreo" type="email" placeholder="Correo electrónico" aria-label="Correo electrónico" required>
      <input name="telefono" id="registroTelefono" type="tel" placeholder="+56 9 1234 5678" aria-label="Teléfono">
      <input name="password" id="registroPassword" type="password" placeholder="Contraseña" aria-label="Contraseña" minlength="8" required>
      <p class="subtitulo">La contraseña debe tener al menos 8 caracteres.</p>
      <button class="btn-register" type="submit" id="btnCrearCuenta">Crear cuenta</button>
      <a href="/usuarios/login" class="btn-secundario">Cancelar</a>
      <a href="/usuarios/login" class="login-link">¿Ya tienes cuenta? Inicia sesión</a>
    </form>
  </main>
  <%- include('Partials/profile-onboarding') %>
  <script src="/Js/app.js"></script>
</body>
</html>
