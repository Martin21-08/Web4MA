<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/Css/Style.css">
  <title>Iniciar sesión</title>
</head>
<body>
  <main class="modal-fondo">  
    <form class="modal-caja" id="formLogin">
      <div class="icono-cocina">🍳</div>
      <h2>¡Hola de nuevo!</h2>
      <p class="subtitulo">Entra y sigue disfrutando de tus recetas.</p>

      <input type="email" placeholder="Correo electrónico" aria-label="Correo electrónico" id="Usuario" required>

      <input type="password" placeholder="Contraseña" aria-label="Contraseña" id="Password" required>

      <button class="btn-login" type="submit" id="go">Entrar</button>

      <button class="btn-login" type="button">Iniciar sesion por Google</button>

      <button class="btn-login" type="button">Iniciar sesion por SMS</button>

      <button class="btn-secundario" type="button">Cancelar</button>

      <a href="/register" class="registrar-link">¿No tienes cuenta? Regístrate</a>
    </form>
  </main>
  <script src="/Js/app.js"></script>
</body>
</html>
