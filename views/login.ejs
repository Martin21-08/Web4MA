<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/Css/Style.css">
  <title>Iniciar sesión</title>
</head>
<body>
  <main class="modal-fondo">  
    <form action="/login" method="POST" class="modal-caja" id="formLogin">
      <div class="icono-cocina">🍳</div>
      <h2>¡Hola de nuevo!</h2>
      <p class="subtitulo">Entra y sigue disfrutando de tus recetas.</p>

      <input type="email" name="email-login" placeholder="Correo electrónico" aria-label="Correo electrónico" id="Usuario" required>

      <input type="password" name="password-login" placeholder="Contraseña" aria-label="Contraseña" id="Password" required>

      <button class="btn-login" type="submit" id="go">Entrar</button>

      <!-- El módulo firebase-auth.js escucha este id y abre el selector de Google. -->
      <button class="btn-login" type="button" id="iniciarConGoogle">Iniciar sesión con Google</button>

      <input type="tel" id="telefonoLogin" placeholder="Teléfono (+56 9 1234 5678)" aria-label="Teléfono para iniciar sesión" autocomplete="tel" hidden>
      <input type="text" id="codigoSMS" placeholder="Código recibido por SMS" aria-label="Código recibido por SMS" inputmode="numeric" autocomplete="one-time-code" hidden>
      <div id="recaptcha-container"></div>
      <button class="btn-login" type="button" id="iniciarConSMS">Iniciar sesión por SMS</button>

      <button class="btn-secundario" type="button">Cancelar</button>

      <a href="/register" class="registrar-link">¿No tienes cuenta? Regístrate</a>
    </form>
  </main>
  <%- include('Partials/profile-onboarding') %>
  <script src="/Js/app.js"></script>
  <script type="module" src="/Js/firebase-auth.js"></script>
</body>
</html>
