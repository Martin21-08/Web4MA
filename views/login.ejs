<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/Css/Style.css">
  <title>Iniciar sesión</title>
</head>
<body>
  <main class="modal-fondo">  
    <section class="modal-caja">
      <div class="icono-cocina">🍳</div>
      <h2>¡Hola de nuevo!</h2>
      <p class="subtitulo">Entra y sigue disfrutando de tus recetas.</p>

      <input type="text" placeholder="Nombre de usuario" aria-label="Nombre de usuario" id="Usuario">

      <input type="password" placeholder="Contraseña" aria-label="Contraseña" id="Password">

      <button class="btn-login" id="go"> Entrar </button>

      <button class="btn-login">Iniciar sesion por Google </button>

      <button class="btn-login">Iniciar sesion por SMS </button>

      <button class="btn-secundario" type="button">Cancelar</button>

      <a href="/register" class="registrar-link">¿No tienes cuenta? Regístrate</a>
    </section>
  </main>
  <script src="/Js/app.js"></script>
</body>
</html>
