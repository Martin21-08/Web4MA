<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cocinar | Mi cocina</title>
  <link rel="stylesheet" href="/Css/Style.css">
</head>
<body>
  <div class="inicio-app">
  <%- include('Partials/Sidebar') %>  
    <main class="inicio-contenido">
      <header class="inicio-encabezado"> 
        <h1>¿Qué deseas cocinar hoy?</h1>
        <p>Elige tus ingredientes y obtén ideas ricas para preparar.</p>
      </header>

      <section class="buscador-caja">
        <div class="buscador-linea">
          <input id="buscarIngrediente" type="text" placeholder="Busca un ingrediente, por ejemplo: tomate" autocomplete="off">
          <button class="boton-tuerca" id="abrirFiltros" aria-label="Abrir filtros">⚙</button>
        </div>
        <div class="sugerencias" id="sugerencias"></div>
        <div class="ingredientes-elegidos" id="ingredientesElegidos"></div>
        <div class="opciones-busqueda">
          <label class="faltantes-check"><input type="checkbox" id="pedirFaltantes"> Mostrar ingredientes faltantes</label>
          <label class="faltantes-check"><input type="checkbox" id="usarDespensa"> Usar mi despensa</label>
          <button class="boton-generar" id="generarRecetas">✨ Generar recetas</button>
        </div>
      </section>

      <h2 class="resultados-titulo">Tus recetas</h2>
      <section class="recetas-grid" id="recetas"></section>

  <div class="modal-inicio" id="modalFiltros">
    <section class="modal-panel">
      <button class="modal-cerrar" data-cerrar="modalFiltros">Cerrar</button>
      <h2>Ajusta tu receta</h2>
      <div class="filtros-grupo"><h3>Tiempo de preparación</h3><div class="filtros-opciones" id="tiempos"></div></div>
      <div class="filtros-grupo"><h3>Porciones</h3><div class="filtros-opciones" id="porciones"></div></div>
      <div class="filtros-grupo"><h3>Evitar ingredientes</h3><input class="evitar-buscar" id="buscarEvitar" placeholder="Escribe para buscar ingredientes a evitar"><div class="sugerencias" id="sugerenciasEvitar"></div><div class="ingredientes-elegidos" id="ingredientesEvitados"></div></div>
      <div class="filtros-grupo"><h3>Dificultad</h3><div class="filtros-opciones" id="dificultad"></div></div>
      <div class="acciones-filtro"><button class="boton-generar" data-cerrar="modalFiltros">Guardar filtros</button></div>
    </section>
  </div>

  <div class="modal-inicio" id="modalReceta">
    <section class="modal-panel" id="detalleReceta"></section>
  </div>
</main>
  <script src="/Js/app.js"></script>
</body>
</html>
