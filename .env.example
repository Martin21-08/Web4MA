# Puerto del servidor Express
PORT=3000

# Copia estos valores desde Firebase Console > Configuración del proyecto > Tus apps > Web.
# La configuración web se puede enviar al navegador; las reglas de Firebase son
# las que protegen tus datos. No pongas aquí claves privadas de una cuenta de servicio.
FIREBASE_API_KEY=pega_aqui_tu_apiKey
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abc123def456
